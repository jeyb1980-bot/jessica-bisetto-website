---
/*
  Dekorative Wasserebene am unteren Bildschirmrand — liegt fest hinter
  dem Inhalt und schimmert dort durch, wo Abschnitte durchsichtig sind.

  Drei Ebenen mit unterschiedlichem Tempo; jede wandert waagerecht und
  hebt sich zugleich leicht.

  Rein dekorativ: aria-hidden, pointer-events: none.
*/
const WAVE_A =
  "M0,100 C200,40 400,160 600,100 C800,40 1000,160 1200,100 C1400,40 1600,160 1800,100 C2000,40 2200,160 2400,100 L2400,200 L0,200 Z";
const WAVE_B =
  "M0,120 C200,64 400,176 600,120 C800,64 1000,176 1200,120 C1400,64 1600,176 1800,120 C2000,64 2200,176 2400,120 L2400,200 L0,200 Z";
const WAVE_C =
  "M0,140 C200,96 400,184 600,140 C800,96 1000,184 1200,140 C1400,96 1600,184 1800,140 C2000,96 2200,184 2400,140 L2400,200 L0,200 Z";
---
<div class="bg-wave" aria-hidden="true">
  <div class="bg-wave__layer bg-wave__layer--a">
    <svg class="bg-wave__svg" viewBox="0 0 2400 200" preserveAspectRatio="none">
      <path d={WAVE_A} fill="currentColor" />
    </svg>
  </div>
  <div class="bg-wave__layer bg-wave__layer--b">
    <svg class="bg-wave__svg" viewBox="0 0 2400 200" preserveAspectRatio="none">
      <path d={WAVE_B} fill="currentColor" />
    </svg>
  </div>
  <div class="bg-wave__layer bg-wave__layer--c">
    <svg class="bg-wave__svg" viewBox="0 0 2400 200" preserveAspectRatio="none">
      <path d={WAVE_C} fill="currentColor" />
    </svg>
  </div>
</div>
