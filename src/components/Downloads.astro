---
// Flyer-Kachel vorübergehend entfernt, bis die PDF vorliegt (flyer-coaching-ueberblick.pdf).
// Bei der Domain-Migration nochmal bei Jessi nachfragen, ob die Datei inzwischen da ist.
const DOWNLOADS = [
  {
    eb: "Kinder & Eltern",
    tone: "kinder",
    title: "Schreib’s auf — Tagebuch-Seite",
    desc: "Eine Seite für einen Tag: Was war gut, was war es nicht — und was habe ich selbst dazu beigetragen. Mit Stolz- und Stimmungs-Barometer.",
    file: "/downloads/tagebuch-schreibs-auf.pdf",
    meta: "PDF · A4",
  },
  {
    eb: "Kinder & Eltern",
    tone: "kinder",
    title: "Gefühls-Memory",
    desc: "Sechzehn Karten, acht Gefühle. Wer ein Paar findet, erzählt dazu — so wird aus dem Spiel nebenbei ein Gespräch über Gefühle.",
    file: "/downloads/gefuehls-memory.pdf",
    meta: "PDF · A4",
  },
  {
    eb: "Kinder & Eltern",
    tone: "kinder",
    title: "Papierpuppe — Löwe",
    desc: "Eine Bastelvorlage zum Ausschneiden. Mit kleinen Fragen für nebenher: Was macht dich mutig? Wann brüllst du, wann schmust du?",
    file: "/downloads/papierpuppe-loewe.pdf",
    meta: "PDF · A4",
  },
  {
    eb: "Für Eltern",
    tone: "erwachsene",
    title: "Wenn zu Hause alles zusammenbricht",
    desc: "In der Kita lief alles gut — und daheim kippt es. Warum das passiert und was in dieser Viertelstunde hilft, auf einer Seite.",
    file: "/downloads/leitfaden-ankommen.pdf",
    meta: "PDF · A4",
  },
];
---
<section class="dl" id="material">
  <div class="dl__head">
    <p class="eyebrow">Material zum Mitnehmen</p>
    <h2 class="h1">Geschenkt, ohne Anmeldung.</h2>
    <p class="lede dl__lede">
      Vorlagen, Reflexionshilfen und Übersichten — alles direkt zum
      Herunterladen. Wenn dir etwas davon hilft, freue ich mich, wenn
      du es weitergibst.
    </p>
  </div>
  <div class="dl__grid">
    {DOWNLOADS.map((d) => (
      <a href={d.file} download class={`dl-card dl-card--${d.tone}`}>
        <div class="dl-card__corner" aria-hidden="true">
          <svg width="32" height="40" viewBox="0 0 32 40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
            <path d="M4 2 L22 2 L30 10 L30 38 L4 38 Z" />
            <path d="M22 2 L22 10 L30 10" />
          </svg>
        </div>
        <p class="eyebrow dl-card__eb">{d.eb}</p>
        <h3 class="dl-card__t">{d.title}</h3>
        <p class="dl-card__d">{d.desc}</p>
        <div class="dl-card__foot">
          <span class="dl-card__meta">{d.meta}</span>
          <span class="dl-card__cta">
            Herunterladen
            <span class="arr" aria-hidden="true">↓</span>
          </span>
        </div>
      </a>
    ))}
  </div>

  {/* Der Verweis steht bewusst unter dem Raster: Die Kacheln sind selbst
      Links auf die PDF — ein zweiter Link darin wäre kein gültiges HTML. */}
  <p class="dl__mehr">
    Zum letzten Blatt gibt es einen ausführlichen Beitrag im Blog:{" "}
    <a href="/blog/ankommen-nach-kita-und-schule">Warum dein Kind ausgerechnet bei dir zusammenbricht</a>
  </p>
</section>
