---
import { getPartners } from "../lib/sanity";

const fallbackFlat = [
  { name: "Stadt Schwäbisch Gmünd", kategorie: "Städte & Kommunen" },
  { name: "Stadt Lorch", kategorie: "Städte & Kommunen" },
  { name: "Stadtbibliothek Heidenheim", kategorie: "Städte & Kommunen" },
  { name: "VHS Schwäbisch Gmünd", kategorie: "Volkshochschulen" },
  { name: "VHS Schwäbisch Hall · IWK", kategorie: "Volkshochschulen" },
  { name: "VHS Aalen", kategorie: "Volkshochschulen" },
  { name: "VHS Crailsheim", kategorie: "Volkshochschulen" },
  { name: "VHS Gerlingen", kategorie: "Volkshochschulen" },
  { name: "GSS Crailsheim", kategorie: "Schulen" },
  { name: "Parler-Gymnasium Schwäbisch Gmünd", kategorie: "Schulen" },
  { name: "Heideschule Mutlangen", kategorie: "Schulen" },
  { name: "Gymnasium bei St. Michael, Schwäbisch Hall", kategorie: "Schulen" },
  { name: "Realschule zur Flügelau Crailsheim", kategorie: "Schulen" },
  { name: "Theodor-Heuss-Schule Herlikofen", kategorie: "Schulen" },
  { name: "Mozartschule Hussenhofen", kategorie: "Schulen" },
  { name: "Karl-Stirner-Schule Rosenberg", kategorie: "Schulen" },
  { name: "Rauchbeinschule, Schwäbisch Gmünd", kategorie: "Schulen" },
  { name: "St.-Josef-Schule, Schwäbisch Gmünd", kategorie: "Schulen" },
  { name: "Uhlandschule Schwäbisch Gmünd", kategorie: "Schulen" },
  { name: "Mundi", kategorie: "Soziale Einrichtungen" },
  { name: "Frauen helfen Frauen e.V.", kategorie: "Soziale Einrichtungen" },
  { name: "Triumph, Heubach", kategorie: "Unternehmen" },
];

let flat = fallbackFlat;
try {
  const fromCms = await getPartners();
  if (fromCms && fromCms.length > 0) flat = fromCms;
} catch {
  // Sanity noch nicht erreichbar — Fallback greift.
}

const VISIBLE_PER_GROUP = 4;
const order: string[] = [];
const byCategory = new Map<string, string[]>();
for (const p of flat) {
  if (!byCategory.has(p.kategorie)) {
    byCategory.set(p.kategorie, []);
    order.push(p.kategorie);
  }
  byCategory.get(p.kategorie)!.push(p.name);
}
const groups = order.map((label) => {
  const items = byCategory.get(label)!;
  return {
    label,
    items: items.slice(0, VISIBLE_PER_GROUP),
    moreItems: items.slice(VISIBLE_PER_GROUP),
  };
});
---
<section class="partners">
  <p class="eyebrow partners__eb">Vertraut von</p>
  <div class="partners__groups">
    {groups.map((g) => (
      <div class="partners__group">
        <p class="partners__glabel">{g.label}</p>
        <ul class="partners__list">
          {g.items.map((p) => (
            <li class="partners__cell">{p}</li>
          ))}
          {g.moreItems.length > 0 && (
            <li class="partners__cell partners__more partners__more--has-pop" tabindex="0">
              <span class="partners__more-label">
                und {g.moreItems.length} weitere
                <svg
                  class="partners__more-chev"
                  width="11"
                  height="11"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="4 6 8 10 12 6" />
                </svg>
              </span>
              <ul class="partners__pop" role="list">
                {g.moreItems.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </li>
          )}
        </ul>
      </div>
    ))}
  </div>
</section>
