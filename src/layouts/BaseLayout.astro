---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundWave from "../components/BackgroundWave.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current = "" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/logo.png" type="image/png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} · Jessica Bisetto</title>
    <meta name="description" content={description} />

    <link rel="preload" href="/fonts/newsreader-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Jessica Bisetto`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <BackgroundWave />
    <Header current={current} />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>
